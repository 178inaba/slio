; The binary still takes its version from the tag — GoReleaser embeds it at
; build time — but the plugin manifest carries a version of its own, so tagpr
; keeps that one in sync: it then travels inside the tree the stable tag
; points at, and the plugin cannot advertise a version its content does not
; match. GoReleaser also creates the GitHub Release, which is why tagpr must
; not.
[tagpr]
	releaseBranch = main
	versionFile = .claude-plugin/plugin.json
	vPrefix = true
	release = false
